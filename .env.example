# Copy this file to .env locally and fill your own key.
# Never commit real secrets.
# Default provider remains Zhipu / BigModel for backward compatibility.
AEGIS_LLM_PROVIDER=zhipu
BIGMODEL_API_KEY=your_api_key_here

# Optional provider-specific keys. Fill only the provider you use.
OPENAI_API_KEY=
KIMI_CODE_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
LLM_API_KEY=

# Optional overrides
BIGMODEL_MODEL=glm-5
BIGMODEL_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
KIMI_CODE_MAX_TOKENS=8192
DEEPSEEK_MAX_TOKENS=8192
MINIMAX_MAX_TOKENS=8192
PUBLIC_TRIAL_KIMI_TIMEOUT_SECONDS=55
PUBLIC_TRIAL_DEEPSEEK_TIMEOUT_SECONDS=90
PUBLIC_TRIAL_MINIMAX_TIMEOUT_SECONDS=120
PUBLIC_TRIAL_KIMI_REPAIR_TIMEOUT_SECONDS=35
PUBLIC_TRIAL_DEEPSEEK_REPAIR_TIMEOUT_SECONDS=60
PUBLIC_TRIAL_MINIMAX_REPAIR_TIMEOUT_SECONDS=90

# Optional image-understanding bridge.
# Keep the public upload entry disabled until real CLI image tests pass on the server.
AEGIS_VISION_PUBLIC_ENABLED=0
# Production/public gateway option: keep the real image-reading CLI on your
# server, then let Vercel/local web proxy image-analysis requests to it.
VISION_BACKEND_URL=
VISION_BACKEND_API_KEY=
VISION_BACKEND_TIMEOUT_SECONDS=360

# Preferred for reusing a real server terminal login: install a CLI on the
# server, verify it can read images, then set a command template. The backend
# replaces {image_path}, {prompt_path}, and optionally {output_path}.
# Example:
# KIMI_VISION_CLI_COMMAND=python3 scripts/kimi_vision_cli_bridge.py {image_path} {prompt_path}
KIMI_VISION_CLI_COMMAND=
KIMI_VISION_CLI_BINARY=kimi
KIMI_VISION_IMAGE_TOKEN_TEMPLATE=@{image_path}
# Optional: use this when the real terminal tool is not Kimi-shaped.
# Example: KIMI_VISION_CLI_ARGS_JSON=["--quiet","-p","{prompt}"]
KIMI_VISION_CLI_ARGS_JSON=
KIMI_VISION_CLI_TIMEOUT_SECONDS=180

# Optional Gemini fallback. This is the simplest API path when server CLI
# automation is blocked. Do not commit a real key.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-flash-lite-latest
GEMINI_VISION_TIMEOUT_SECONDS=45
GEMINI_VISION_MAX_TOKENS=1200
GEMINI_VISION_RETRIES=2
GEMINI_VISION_RETRY_BACKOFF_SECONDS=1.5

# Optional generic OpenAI-compatible vision provider. Useful for Kimi/Moonshot,
# Qwen-compatible gateways, OpenAI-compatible routers, or a private proxy.
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
VISION_PROVIDER_NAME=openai-compatible-vision
VISION_TIMEOUT_SECONDS=45
VISION_MAX_TOKENS=1200
VISION_RETRIES=2
VISION_RETRY_BACKOFF_SECONDS=1.5

# Optional OCR fallback. The command should print UTF-8 text to stdout, or write
# it to {output_path}. This is text-only fallback, not full image reasoning.
# Example: VISION_OCR_COMMAND=paddleocr --image_dir {image_path}
VISION_OCR_COMMAND=
VISION_OCR_TIMEOUT_SECONDS=90

KIMI_VISION_API_KEY=
KIMI_VISION_BASE_URL=https://api.moonshot.cn/v1
KIMI_VISION_MODEL=kimi-latest
AEGIS_VISION_MAX_IMAGE_BYTES=5242880
AEGIS_VISION_MAX_REQUEST_BYTES=7340032

# Optional base URL for non-Zhipu providers or custom compatible gateways.
# Examples:
# AEGIS_LLM_PROVIDER=openai
# AEGIS_LLM_BASE_URL=https://api.openai.com/v1
# AEGIS_LLM_PROVIDER=minimax-token-cn
# AEGIS_LLM_BASE_URL=https://api.minimaxi.com/anthropic/v1
# AEGIS_LLM_PROVIDER=codex-local-proxy
# AEGIS_LLM_BASE_URL=http://127.0.0.1:8317/api/provider/antigravity/v1
# AEGIS_LLM_PROVIDER=codex-cli
# CODEX_CLI_MODEL=gpt-5.5
# CODEX_BIN=codex
AEGIS_LLM_BASE_URL=

# Optional cloud render executor.
# Leave MANIM_EXECUTOR=local for local/Render in-container rendering.
# Set MANIM_EXECUTOR=cloud_run only after creating a Cloud Run Job that runs
# render_backend/cloud_run_worker.py and has Supabase env configured.
MANIM_EXECUTOR=local
CLOUD_RUN_PROJECT=
CLOUD_RUN_REGION=
CLOUD_RUN_JOB_NAME=
CLOUD_RUN_JOB_TIMEOUT_SECONDS=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
